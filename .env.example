# Server Configuration
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data

# LLM Providers (Configure at least one or configure later in the Web UI Settings)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Default Models
# Providers: openai | gemini | anthropic | groq
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# Embedding Providers: openai | gemini | huggingface
# huggingface runs locally on CPU with zero API key required!
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
